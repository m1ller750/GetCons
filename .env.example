# =============================================================================
# GetCons configuration. Copy to .env for local development; on Railway set the
# same variables in the service's "Variables" tab. Never commit real values.
# =============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Public key (legacy "anon" or new "publishable"). Safe to expose to browsers.
SUPABASE_ANON_KEY=
# SERVER ONLY. Legacy "service_role" or new "secret" key. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini ---------------------------------------------------------------
# AI Studio key (https://aistudio.google.com/apikey, "AIza...") or a Google Cloud key for
# Vertex AI ("AQ..."). The server works out which endpoint accepts the key by itself.
GEMINI_API_KEY=
# auto | gemini-api | vertex
GEMINI_BACKEND=auto
# Chat model used by every consultant.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional backup model, used if the primary returns 404/429/5xx.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Embeddings for RAG. Must output 768 dims (matches the database). If you change it,
# run `npm run reembed --workspace server`.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: MINIMAL | LOW | MEDIUM | HIGH (only for models that support thinking levels).
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_MS=15000

# --- Backup model: answers when Gemini fails (optional) ---------------------------
# Grok by xAI (https://console.x.ai) or any OpenAI-compatible API: then also set its address.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast-non-reasoning

# --- Security ------------------------------------------------------------------
# 32 random bytes used to encrypt Telegram bot tokens (AES-256-GCM).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: changing it makes stored bot tokens unreadable (bots must be reconnected).
ENCRYPTION_KEY=

# --- Server & Telegram ----------------------------------------------------------
PORT=8080
# Public https URL of this app (Telegram webhooks point here). On Railway this is
# derived automatically from RAILWAY_PUBLIC_DOMAIN, so you can leave it empty.
PUBLIC_URL=
# One-click bot creation (Telegram Managed Bots). Token of YOUR platform bot (e.g. @GetConsBot)
# with "Bot Management" enabled in the @BotFather mini app. Without it, users paste tokens manually.
MANAGER_BOT_TOKEN=
# auto = webhook when PUBLIC_URL is https, otherwise long polling (local dev).
TELEGRAM_MODE=auto
# WhatsApp: owners link a work number as a linked device (QR code / pairing code).
# Sessions are stored encrypted in Supabase. Run a single replica: one session per number.
WHATSAPP_ENABLED=true

# --- Card payments for plans (Freedom Pay, Kazakhstan) ------------------------------
# Customers pay on Freedom Pay's secure page; card details never reach this server.
# Payouts go to the account set in your Freedom Pay merchant contract.
# Merchant ID and secret key: Freedom Pay merchant cabinet → Settings. Leave empty to
# show plans without checkout. Result URL for the cabinet: <PUBLIC_URL>/api/billing/freedompay/result
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
# true = test payments only (no money moves). Set false after Freedom Pay switches you to live.
FREEDOMPAY_TESTING=false
# Only needed if the dashboard is served from another origin.
CORS_ORIGINS=
LOG_LEVEL=info

# --- Limits (cost & abuse control) --------------------------------------------
MAX_CONSULTANTS_PER_USER=3
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_PER_CONSULTANT=200
MAX_EXAMPLES_PER_CONSULTANT=2000
DAILY_REPLY_LIMIT=2000
MESSAGES_PER_CHAT_PER_MINUTE=20

# --- Retrieval tuning ------------------------------------------------------------
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.3
FEW_SHOT_K=4
MAX_PINNED_EXAMPLES=3
